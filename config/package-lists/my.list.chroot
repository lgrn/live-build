zstd
grep-dctrl
efibootmgr
keychain
gpg
apt-transport-https
curl
tmux
net-tools
mtr-tiny
dnsutils
rsync
gdu
jq
git
ripgrep

# meta-package for drivers

live-task-non-free-firmware-pc

# the above package recommends, and therefore installs, the following:
# rec: amd64-microcode
#     Platform firmware and microcode for AMD CPUs and SoCs
# rec: bluez-firmware
#     Firmware for Bluetooth devices
# rec: firmware-amd-graphics
#     Binary firmware for AMD/ATI graphics and NPU chips
# rec: firmware-atheros
#     Binary firmware for Qualcomm Atheros wireless cards
# rec: firmware-brcm80211
#     Binary firmware for Broadcom/Cypress 802.11 wireless cards
# rec: firmware-intel-sound
#     Binary firmware for Intel sound DSPs
# rec: firmware-ipw2x00
#     Binary firmware for Intel Pro Wireless 2100, 2200 and 2915
# rec: firmware-iwlwifi
#     Binary firmware for Intel Wireless cards
# rec: firmware-linux
#     Binary firmware for various drivers in the Linux kernel (metapackage)
# rec: firmware-linux-nonfree
#     Binary firmware for various drivers in the Linux kernel (metapackage)
# rec: firmware-realtek
#     Binary firmware for Realtek network and audio chips
# rec: firmware-sof-signed
#     Intel SOF firmware - signed
# rec: intel-microcode
#     Processor microcode firmware for Intel CPUs

# other firmware packages that may be needed, but not
# included by default to conserve space
#
# firmware-ath9k-htc
# atmel-firmware
# firmware-libertas
# firmware-zd1211

# NOTE: 9999-final.hook.chroot may remove firmware selected above,

