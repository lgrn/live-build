#!/bin/bash

set -e

# remove packages to conserve space

for PACKAGE in aptitude info totem firmware-netronome firmware-qcom-soc \
firmware-libertas firmware-marvell-prestera pocketsphinx-en-us raspi-firmware \
ibus-data git firmware-nvidia-* \
firmware-cavium firmware-qlogic firmware-myricom firmware-netxen dahdi-firmware-nonfree
do
        if ! apt-get remove --purge --yes "${PACKAGE}"
        then
                echo "WARNING: ${PACKAGE} isn't installed"
        else
                echo "OK: ${PACKAGE} purged"
        fi
done

apt-get autoremove --yes || true

sudo useradd -m -s /usr/bin/bash trixie || true
sudo chown -Rv trixie:trixie /home/trixie
echo "trixie:live" | sudo chpasswd

# Removing assumed crap

rm -rf /usr/share/help
rm -rf /usr/share/doc
rm -rf /var/lib/apt
rm -rf /var/cache/*

for d in /usr/share/locale/*; do
  if [ "$d" != "/usr/share/locale/en" ] && [ "$d" != "/usr/share/locale/sv" ]; then
    echo "Removing $d"
    rm -rf -- "$d"
  fi
done

# disable timers unsuitable for live environments

timers=(
  apt-daily-upgrade
  apt-daily
  dpkg-db-backup
  fstrim
  man-db
)

UNIT_DIRS=(
  /lib/systemd/system
  /etc/systemd/system
  /etc/systemd/system/*.wants
)

for t in "${timers[@]}"; do
  for d in "${UNIT_DIRS[@]}"; do
    # expand any globs, then remove matching .timer files or symlinks
    for f in $d/${t}.timer*; do
      [ -e "$f" ] && {
        echo "Removing $f"
        rm -rf -- "$f"
      }
    done
  done
done

# set dark mode and wallpaper in gnome, then compile schemas (ie apply)

cat <<EOF >> /usr/share/glib-2.0/schemas/theme-override.gschema.override || echo "Not setting dark mode, file missing" && true
[org.gnome.desktop.interface]
gtk-theme='Adwaita-dark'
color-scheme='prefer-dark'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/gnome/blobs-l.svg'

EOF

glib-compile-schemas /usr/share/glib-2.0/schemas/ || true

# Removing unused files
find . -name *~ -print0 | xargs -0 rm -f

# Truncating logs
for FILE in $(find /var/log/ -type f)
do
        : > "${FILE}"
done

echo "*** Top20 Largest Packages ***"

dpkg-query -W --showformat='${Installed-Size}\t${Package}\n' \
  | sort -nr \
  | head -n 20 \
  | awk '{printf "%6.1f MB\t%s\n",$1/1024,$2}'

echo ""
echo "*** Top20 Largest FIRMWARE Packages ***"

dpkg-query -W --showformat='${Installed-Size}\t${Package}\n' \
  | grep firmware \
  | sort -nr \
  | head -n 20 \
  | awk '{printf "%6.1f MB\t%s\n",$1/1024,$2}'
